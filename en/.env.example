# Copy as .env and adjust. Locally almost everything works by default.
PORT=3100

# JWT secret (in production, mandatory and random):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-insecure-secret-change-in-production
ACCESS_TOKEN_TTL=2h

DATABASE_FILE=./data/polleria.db

# OPTIONAL initial admin (owner). Leave it commented to create it from /admin.html on first use.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Load sample products/shop the first time
SEED_SAMPLE_DATA=true

TRUST_PROXY=false

# Local HTTPS (run npm run gen-cert first)
TLS_ENABLED=false
TLS_KEY_FILE=./certs/key.pem
TLS_CERT_FILE=./certs/cert.pem

NODE_ENV=development
